# Normalize all text files to LF in repo, checkout as OS-native
* text=auto

# Force LF for these (avoid CRLF issues on Windows)
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.sql   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf

# Binary files - don't touch
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.xlsx  binary
