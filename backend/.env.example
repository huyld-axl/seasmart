PORT=3000
HOST=0.0.0.0

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=marineport

# JWT — REQUIRED: replace with a strong random secret (min 32 chars)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# File storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
