PORT=3000
HOST=0.0.0.0

# PostgreSQL (Docker deployment supplies these values automatically)
DB_HOST=localhost
DB_PORT=5432
DB_USER=seasmart
DB_PASSWORD=
DB_NAME=seasmart

# JWT — REQUIRED: replace with a strong random secret (min 32 chars)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_SECRET_FILE=
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# File storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Biểu mẫu Excel: mặc định đọc forms/ tại root dự án. Điền để dùng thư mục khác
FORMS_DIR=

# AI đọc giấy tờ (openai | anthropic). Thiếu key hoặc mã model thì báo "AI chưa được cấu hình".
AI_PROVIDER=openai
OPENAI_API_KEY=
# Để trống nếu gọi thẳng OpenAI; điền khi dùng máy chủ trung gian hoặc endpoint theo vùng
OPENAI_BASE_URL=
# Model nhỏ: tách trang, đọc chứng chỉ. Model mạnh: đọc sổ thuyền viên
OPENAI_MODEL_SMALL=
OPENAI_MODEL_STRONG=
AI_CONCURRENCY=3
AI_TIMEOUT_MS=120000
# Khi AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Xuất giấy tờ ra PDF cần LibreOffice trên máy chủ. Bỏ trống thì dùng lệnh `soffice`.
SOFFICE_PATH=

# Cổng gửi SMS: HTTP nhận POST JSON { to, text }, token gửi dạng Bearer. Hiện không tính năng nào dùng.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Mail server công ty (SMTP), dùng gửi thư mời kích hoạt tài khoản. Để trống SMTP_HOST thì không gửi thư.
# SMTP_USE_SSL=true: TLS ngay khi kết nối (cổng 465). SMTP_USE_TLS=true: STARTTLS (cổng 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MarinePort

# Địa chỉ frontend, dùng dựng link trong thư mời
APP_URL=http://localhost:5173
