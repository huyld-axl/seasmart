JWT_EXPIRES_IN=7d

# CORS - comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# File storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# External vessel sync/decrypt
VESSEL_API_BASE_URL=http://157.180.60.155:8888

# Anthropic AI (optional - enables certificate AI extraction)
ANTHROPIC_API_KEY=
