PORT=3000
HOST=0.0.0.0

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=marineport

# JWT — REQUIRED: replace with a strong random secret (min 32 chars)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# File storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Biểu mẫu Excel thật (ngoài repo, không commit)
FORMS_DIR=

# AI đọc giấy tờ (Claude). Trống thì giấy tải lên báo "chưa cấu hình", không giả kết quả.
ANTHROPIC_API_KEY=

# Gửi link ký qua SMS: cổng HTTP nhận POST JSON { to, text }, token gửi dạng Bearer.
# APP_URL là địa chỉ frontend để dựng link ký.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
APP_URL=http://localhost:5173
