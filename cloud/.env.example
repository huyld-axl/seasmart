# Biến môi trường của máy chủ dịch vụ MCAH. Chép thành cloud/.env để chạy trên máy dev (tệp .env không commit).
# Máy chủ thật: đặt các biến này ở nơi cất secret của server, không để trong repo.

# Google (Google Cloud Console → Google Auth Platform → Clients, loại Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Địa chỉ công khai của trang web tài khoản (liên kết trong thư, chuyển hướng Google).
# Máy dev dùng localhost (Google chỉ cho http với localhost, không nhận 127.0.0.1).
# Server dev: https://mcah.axalize.dev/tai-khoan
CLOUD_PUBLIC_URL=http://localhost:4100

# Khoá ký cookie trang web (máy chủ thật bắt buộc, ít nhất 32 ký tự ngẫu nhiên: openssl rand -hex 32). Máy dev để trống.
CLOUD_COOKIE_SECRET=

# Email nội bộ vào được trang /quan-tri (phẩy giữa các email)
CLOUD_ADMIN_EMAILS=

# Thư hệ thống (thư xác minh, quên mật khẩu, lời mời): cùng tên biến với backend/.env, chép nguyên sang được.
# Để trống SMTP_HOST trên máy dev thì thư in ra log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@mcah.vn
SMTP_FROM_NAME=MCAH

# AI đọc giấy tờ và nguồn tra tàu (giống biến cùng tên của backend)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL_SMALL=
OPENAI_MODEL_STRONG=
VESSEL_LOOKUP_PROVIDER=
VESSEL_API_BASE_URL=
VESSEL_API_ENC_KEY=
